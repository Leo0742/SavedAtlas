{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "types": ["node", "electron-vite/node"], "allowSyntheticDefaultImports": true
  },
  "include": ["electron.vite.config.ts", "vite.preview.config.ts", "playwright.config.ts", "e2e/**/*.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts", "tests/**/*.ts"]
}
